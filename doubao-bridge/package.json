{
  "name": "doubao-bridge",
  "version": "2.0.2",
  "private": true,
  "type": "module",
  "description": "Local Doubao bridge for Personal AI memory sync and context injection",
  "main": "app/main.mjs",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "node scripts/build.mjs",
    "start": "node dist/index.js",
    "app:dev": "npm run build && electron app/main.mjs",
    "app:start": "electron app/main.mjs",
    "test": "NODE_ENV=test tsx --test src/**/*.test.ts",
    "macos:signing-info": "node scripts/macos-signing-info.mjs",
    "package:macos": "npm run build && node scripts/package-macos.mjs",
    "deploy": "node scripts/deploy.mjs"
  },
  "dependencies": {
    "fastify": "^5.2.0",
    "playwright": "^1.52.0"
  },
  "devDependencies": {
    "@electron/packager": "^19.1.0",
    "@types/node": "^22.0.0",
    "electron": "^41.1.0",
    "electron-builder": "^26.0.12",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "build": {
    "appId": "com.personalai.doubao-bridge",
    "productName": "Doubao Bridge",
    "asar": false,
    "directories": {
      "output": "release/electron-builder"
    },
    "files": [
      "app/**/*",
      "dist/**/*",
      "!node_modules/playwright-core/.local-browsers{,/**}",
      "package.json",
      "package-lock.json"
    ],
    "mac": {
      "target": [
        "dir"
      ],
      "category": "public.app-category.productivity"
    }
  }
}
