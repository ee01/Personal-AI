{
  "name": "doubao-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local Doubao bridge for Personal AI memory sync and context injection",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "tsx --test src/**/*.test.ts",
    "macos:signing-info": "node scripts/macos-signing-info.mjs",
    "package:macos": "npm run build && node scripts/package-macos.mjs",
    "deploy": "node scripts/deploy.mjs"
  },
  "dependencies": {
    "fastify": "^5.2.0",
    "playwright": "^1.52.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
