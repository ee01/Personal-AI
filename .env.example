# 多久分析一次聊天消息
MESSAGE_ANALYSIS_INTERVAL=180
# 消息上下文窗口（距离此刻的时间范围，单位：分钟）
MESSAGE_CONTEXT_WINDOW=125
ANALYSIS_TYPE=filter
# filter 或 agentThinking 或 agentWorkflow
ANALYZE_BY_GROUP=true
# 是否拆开每个群组独立分析
FILTER_OWN_MESSAGES=true
# 是否过滤自己发送的消息（默认: true）

# LLM 配置
LLM_TYPE=dify
# local 或 openai 或 groq 或 dify

# Ollama 配置
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=deepseek-r1
OLLAMA_REVIEW_MODEL=llama3.1
OLLAMA_QUERY_MODEL=llama3.1

# Dify API 配置
DIFY_API_KEY=
DIFY_REVIEW_API_KEY=
DIFY_API_BASE_URL=https://lap2-api-dev.int.rclabenv.com/v1

# OpenAI 配置
OPENAI_API_KEY=
OPENAI_MODEL=deepseek-ai/deepseek-r1
OPENAI_REVIEW_MODEL=deepseek-ai/deepseek-r1
OPENAI_API_BASE_URL=https://integrate.api.nvidia.com/v1

# Groq 配置
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_REVIEW_MODEL=llama-3.1

# Bot 配置
BOT_API_BASE_URL=https://botman.int.rclabenv.com/v2
BOT_TOKEN=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJlbWFpbCI6ImVzb25lLnFpdUByaW5nY2VudHJhbC5jb20iLCJzZXJ2aWNlIjoiU01fYm90LnNlcnZpY2UiLCJyb2xlIjoiUk9MRV9VU0VSIiwiaWF0IjoxNzM5OTQyMjUyLCJleHAiOjIwNTUzMDIyNTJ9.ieSb3zGIwVhUTqZpkgJipK8ktH4FVJr3vDF0kyQ-4DI
BOT_ID=4700372020@37439510.bot.glip.net
BOT_TYPE=user
# user 或 team
TEAM_ID=1497300893698

# 是否开启消息审核（仅对 notifyMethod 包含 'bot' 的规则生效）
LLM_REVIEW_BEFORE_SEND=true
# 注：ENABLE_BOT 已废弃，使用每个关注规则的 notifyMethod 字段替代（支持 'bot,chrome' 多选）

# 记忆系统 (Memory Service)
MEMORY_SERVICE_BASE_URL=http://localhost:3210/api/v1
# 可选：Memory Service 后端配置 API_KEY 时，扩展需填写相同密钥以通过认证；本地开发通常留空
MEMORY_SERVICE_API_KEY=
MEMORY_SERVICE_TIMEOUT=30000

# Chroma 配置（已废弃，保留兼容）
ENABLE_CHROMA=true
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_SSL=true
CHROMA_API_URL=http://localhost:8000
CHROMA_COLLECTION_NAME=
# 留空代表用 username 作为 collection name


# Jira 配置
JIRA_BASE_URL=
JIRA_USERNAME=
JIRA_API_TOKEN=

# Google 配置
GOOGLE_CLIENT_ID=850492875483-kmbu6or52oi6lsnapoqklbs5fo94jplv.apps.googleusercontent.com

# 个性化配置
ICON_NAME=icon

# 消息交互功能开关
ENABLE_AUTO_REPLY=true
# 启用自动答复功能（默认: true）
ENABLE_SNOOZE=true
# 启用稍后处理功能（默认: true）
