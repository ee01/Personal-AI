{
  "name": "personal-ai",
  "version": "8.0.0",
  "description": "Radar PoC chrome extension",
  "scripts": {
    "start": "webpack --watch --config webpack.dev.cjs",
    "memory": "npm run dev --prefix memory-service",
    "build": "webpack --config webpack.prod.cjs && npm run zip",
    "test:meeting-pilot": "npm --prefix desktop-app run test:meeting-pilot",
    "test:meeting-pilot-panorama": "npm --prefix desktop-app run test:meeting-pilot-panorama",
    "test:meeting-pilot-build-check": "npm --prefix desktop-app run test:meeting-pilot-build-check",
    "test:meeting-pilot-scene1": "npm --prefix desktop-app run test:meeting-pilot-scene1",
    "test:meeting-pilot-history": "npm --prefix desktop-app run test:meeting-pilot-history",
    "test:meeting-pilot-options": "npm --prefix desktop-app run test:meeting-pilot-options",
    "test:meeting-pilot-real-site": "npm --prefix desktop-app run test:meeting-pilot-real-site",
    "test:meeting-pilot-all": "npm --prefix desktop-app run test:meeting-pilot-all",
    "test:meeting-pilot-memory": "npm --prefix memory-service test -- --run src/__tests__/api-recall.test.ts src/__tests__/api-meetings.test.ts src/__tests__/api-ask.test.ts",
    "test:meeting-pilot-verify": "npm run test:meeting-pilot-memory && npm run test:meeting-pilot-all && npm run test:meeting-pilot-real-site",
    "build:desktop": "npm --prefix desktop-app run package:macos",
    "build:app": "npm run build:desktop",
    "deploy": "cd site && git init && git add -A && git commit -m \"Deploy to gh-pages\" && git branch -M gh-pages && git remote add origin git@github.com:ee01/personal-ai.git && git push -f origin gh-pages && rm -rf .git",
    "deploy:desktop": "npm --prefix desktop-app run deploy",
    "deploy:app": "npm run deploy:desktop",
    "deploy:memory": "node tools/deploy-memory-service.mjs",
    "eval:list": "node tools/eval-list.mjs",
    "eval:validate": "node tools/eval-validate.mjs",
    "eval:report": "node tools/eval-report.mjs",
    "eval:run": "node tools/eval-run.mjs",
    "eval:scheduler": "node tools/eval-scheduler.mjs",
    "eval:cron": "node tools/eval-scheduler.mjs --once",
    "zip": "rm personal-ai.zip; cd dist && zip -r ../personal-ai.zip .",
    "backup": "tar -czf ./chroma-backup/chroma-backup-$(date +%Y%m%d).tar.gz ./chroma-data",
    "clean": "rm -rf dist/* && rm personal-ai.zip",
    "verify:project-report": "TS_NODE_TRANSPILE_ONLY=1 node --loader ts-node/esm --experimental-specifier-resolution=node tools/verify-project-report.ts",
    "verify:memory-backup": "TS_NODE_TRANSPILE_ONLY=1 node --loader ts-node/esm --experimental-specifier-resolution=node tools/verify-memory-backup.ts",
    "verify:memory-events-multiuser": "TS_NODE_TRANSPILE_ONLY=1 node --loader ts-node/esm --experimental-specifier-resolution=node tools/verify-memory-events-multiuser.ts && npm --prefix memory-service test -- --run src/__tests__/events.test.ts",
    "verify:memory-user-identity:e2e": "node tools/verify-memory-user-identity-e2e.mjs",
    "verify:message-reaction": "TS_NODE_TRANSPILE_ONLY=1 node --loader ts-node/esm --experimental-specifier-resolution=node --test src/message-reaction/__tests__/*.test.ts",
    "verify:message-reaction:e2e": "npm --prefix desktop-app run test:message-reaction-toolbar",
    "verify:topic-based-messages": "TS_NODE_TRANSPILE_ONLY=1 node --loader ts-node/esm --experimental-specifier-resolution=node tools/verify-topic-based-messages.ts",
    "verify:topic-based-messages:e2e": "node tools/verify-topic-based-messages-e2e.mjs",
    "verify:day-pilot-home": "TS_NODE_TRANSPILE_ONLY=1 node --loader ts-node/esm --experimental-specifier-resolution=node tools/verify-day-pilot-home.ts",
    "verify:today-pilot-home:e2e": "node tools/verify-today-pilot-home-e2e.mjs",
    "verify:memory-timeline": "TS_NODE_TRANSPILE_ONLY=1 node --loader ts-node/esm --experimental-specifier-resolution=node tools/verify-memory-timeline.ts",
    "verify:memory-timeline:e2e": "node tools/verify-memory-timeline-e2e.mjs",
    "verify:memory-coverage:e2e": "node tools/verify-memory-coverage-e2e.mjs",
    "verify:memory-dreams:e2e": "node tools/verify-memory-dreams-e2e.mjs",
    "verify:reflection-research:e2e": "node tools/verify-reflection-research-e2e.mjs",
    "verify:memory-search-results": "TS_NODE_TRANSPILE_ONLY=1 node --loader ts-node/esm --experimental-specifier-resolution=node tools/verify-memory-search-results.ts",
    "verify:memory-search-scope:e2e": "node tools/verify-memory-search-scope-e2e.mjs",
    "verify:memory-search-feedback:e2e": "node tools/verify-memory-search-feedback-e2e.mjs",
    "verify:i18n": "TS_NODE_TRANSPILE_ONLY=1 node --loader ts-node/esm --experimental-specifier-resolution=node tools/verify-i18n.ts",
    "verify:decision-center:e2e": "node tools/verify-decision-center-e2e.mjs",
    "verify:action-queue:e2e": "node tools/verify-action-queue-e2e.mjs",
    "verify:appscript-auto-update": "TS_NODE_TRANSPILE_ONLY=1 node --loader ts-node/esm --experimental-specifier-resolution=node tools/verify-appscript-auto-update.ts",
    "verify:appscript-auto-update:e2e": "node tools/verify-appscript-auto-update-e2e.mjs",
    "verify:digest-queue-service": "TS_NODE_TRANSPILE_ONLY=1 node --loader ts-node/esm --experimental-specifier-resolution=node tools/verify-digest-queue-service.ts",
    "verify:task-scheduler-api": "TS_NODE_TRANSPILE_ONLY=1 node --loader ts-node/esm --experimental-specifier-resolution=node tools/verify-task-scheduler-api.ts",
    "verify:task-scheduler-status-filters": "TS_NODE_TRANSPILE_ONLY=1 node --loader ts-node/esm --experimental-specifier-resolution=node tools/verify-task-scheduler-status-filters.ts",
    "verify:task-scheduler-popup-filters:e2e": "node tools/verify-task-scheduler-popup-filters-e2e.mjs",
    "verify:webpage-memory-detection": "TS_NODE_TRANSPILE_ONLY=1 node --loader ts-node/esm --experimental-specifier-resolution=node tools/verify-webpage-memory-detection.ts",
    "verify:webpage-memory-detection:e2e": "node desktop-app/scripts/webpage-memory-detection-check.mjs",
    "verify:quick-ask:e2e": "npm --prefix desktop-app run test:quick-ask-status-card",
    "verify:context-assist-meeting-prep": "node tools/verify-context-assist-meeting-prep.mjs",
    "verify:ringcentral-native-join:e2e": "node tools/verify-ringcentral-native-join-e2e.mjs",
    "verify:relationship-radar": "npm --prefix memory-service test -- --run src/__tests__/api-relationships.test.ts src/__tests__/migration-relationship-radar-compat.test.ts",
    "verify:relationship-radar:e2e": "node tools/verify-relationship-radar-e2e.mjs",
    "verify:project-dashboard": "TS_NODE_TRANSPILE_ONLY=1 node --loader ts-node/esm --experimental-specifier-resolution=node tools/verify-project-dashboard.ts",
    "verify:project-dashboard:e2e": "node tools/verify-project-dashboard-e2e.mjs",
    "verify:custom-prompts": "TS_NODE_TRANSPILE_ONLY=1 node --loader ts-node/esm --experimental-specifier-resolution=node tools/verify-custom-prompts.ts",
    "verify:custom-prompts:e2e": "node tools/verify-custom-prompts-e2e.mjs",
    "verify:google-slides-analyzer": "TS_NODE_TRANSPILE_ONLY=1 node --loader ts-node/esm --experimental-specifier-resolution=node tools/verify-google-slides-analyzer.ts",
    "verify:google-slides-analyzer:e2e": "node tools/verify-google-slides-analyzer-e2e.mjs",
    "verify:jira-automation-import": "TS_NODE_TRANSPILE_ONLY=1 node --loader ts-node/esm --experimental-specifier-resolution=node --test src/jira-automation-import/__tests__/transform.test.ts",
    "verify:jira-automation-import:e2e": "node tools/verify-jira-automation-import-e2e.mjs",
    "verify:jira-design-links": "TS_NODE_TRANSPILE_ONLY=1 node --loader ts-node/esm --experimental-specifier-resolution=node tools/verify-jira-design-links.ts",
    "verify:jira-design-links:e2e": "node tools/verify-jira-design-links-e2e.mjs",
    "verify:agent-workflow-replay": "TS_NODE_TRANSPILE_ONLY=1 node --loader ts-node/esm --experimental-specifier-resolution=node tools/verify-agent-workflow-replay.ts",
    "verify:agent-workflow": "npm run verify:agent-workflow-replay && TS_NODE_TRANSPILE_ONLY=1 node --loader ts-node/esm --experimental-specifier-resolution=node tools/verify-agent-workflow-diagnostics.ts && TS_NODE_TRANSPILE_ONLY=1 node --loader ts-node/esm --experimental-specifier-resolution=node tools/verify-memory-entry-agent-workflow.ts",
    "verify:scheduled-messages-one-click-setup": "TS_NODE_TRANSPILE_ONLY=1 node --loader ts-node/esm --experimental-specifier-resolution=node tools/verify-scheduled-messages-one-click-setup.ts",
    "verify:scheduled-messages-one-click-setup:e2e": "node tools/verify-scheduled-messages-one-click-setup-e2e.mjs",
    "verify:scheduled-messages-config-sync:e2e": "node tools/verify-scheduled-messages-config-sync-e2e.mjs",
    "verify:scheduled-messages-timeline-cache": "node tools/verify-scheduled-messages-timeline-cache.mjs",
    "verify:scheduled-messages-health-recovery:e2e": "node tools/verify-scheduled-messages-health-recovery-e2e.mjs",
    "verify:scheduled-messages-queue-suggestion:e2e": "node tools/verify-scheduled-messages-queue-suggestion-e2e.mjs",
    "verify:scheduled-messages-crud-focus:e2e": "node tools/verify-scheduled-messages-crud-focus-e2e.mjs"
  },
