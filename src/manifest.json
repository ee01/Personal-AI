{
  "manifest_version": 3,
  "name": "Personal AI",
  "description": "Your personal AI assistant that helps analyze messages and provide insights",
  "version": "5.3.1",
  "permissions": [
    "tabs",
    "storage",
    "activeTab",
    "alarms",
    "background",
    "unlimitedStorage",
    "offscreen",
    "scripting",
    "identity",
    "clipboardRead",
    "clipboardWrite"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://mfe_a-develop.jupiter.int.rclabenv.com/*", 
        "https://rc-a-develop.jupiter.int.rclabenv.com/*",
        "https://app.ringcentral.com/*"
      ],
      "js": ["contentScript.js"]
    },
    {
      "matches": ["https://docs.google.com/spreadsheets/*"],
      "js": ["contentScriptGoogleSheet.js"]
    },
    {
      "matches": [
        "*://*.jira.com/browse/*",
        "*://*.atlassian.net/browse/*",
        "*://jira.ringcentral.com/browse/*"
      ],
      "js": [
        "contentScriptJira.js"
      ],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Personal AI"
  },
  "options_page": "options.html",
  "host_permissions": [
    "*://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "web_accessible_resources": [{
    "resources": ["topic-modal.html", "knowledge-query.html", "offscreen.html", "options.css", "agent-visualizer.css", "icons/icon16.png"],
    "matches": ["<all_urls>"]
  }],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "oauth2": {
    "client_id": "{{GOOGLE_CLIENT_ID}}",
    "scopes": [
      "https://www.googleapis.com/auth/spreadsheets",
      "https://www.googleapis.com/auth/drive.readonly"
    ]
  }
}
