}
```

### 扩展工具系统

要添加新工具，可以通过工具注册表添加：

```typescript
// 注册新工具
toolRegistry['myNewTool'] = {
  id: 'myNewTool',
  name: '我的新工具',
  description: '这是一个自定义工具，用于...',
  parameters: [
    {
      name: 'param1',
      type: 'string',
      description: '参数1的说明',
      required: true
    },
    {
      name: 'param2',
      type: 'number',
      description: '参数2的说明',
      required: false
    }
  ],
  execute: async (params) => {
    // 实现工具逻辑
    return { result: '执行结果' };
  }
};
```

