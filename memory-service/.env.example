# Server
PORT=3210
HOST=0.0.0.0
DATA_DIR=./data
LOG_LEVEL=info
# SQLite defaults to WAL for local/dev read concurrency. Use DELETE + FULL on
# bind-mounted production filesystems if WAL shows corruption or locking issues.
SQLITE_JOURNAL_MODE=WAL
SQLITE_SYNCHRONOUS=NORMAL

# LLM Configuration
# LLM_PROVIDER can be: openai (including OpenAI-compatible endpoints), groq, ollama, dify
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_API_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
GROQ_API_KEY=
DIFY_API_KEY=
# Dify API base URL (e.g. https://api.dify.ai or https://xxx/v1). DIFY_API_BASE_URL also works.
DIFY_API_URL=
# Dify app mode: chat (conversational) or completion (text generation). Use completion if you get "not_chat_app".
DIFY_APP_MODE=completion
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Embedding
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# Auth
# Full-power service key (desktop / ops / deploy). Do NOT ship in the extension.
API_KEY=
# Issue-only bootstrap key for the Chrome extension (scope: keys.issue).
BOOTSTRAP_API_KEY=
# Browser CORS allowlist. Empty = deny browser origins (extension SW needs no CORS).
# Use * to reflect any Origin (legacy / emergency). Comma-separated otherwise.
ALLOWED_ORIGINS=

# Usage analytics dashboard (admin report/users/dashboard)
ANALYTICS_ADMIN_TOKEN=
# HMAC secret for per-user dashboard links (scope=self|all).
# Falls back to ANALYTICS_ADMIN_TOKEN when empty.
ANALYTICS_TOKEN_SECRET=

# Bot（Dream Digest / Weekly Report 推送，留空则跳过 Bot 发送）
BOT_API_BASE_URL=https://botman.int.rclabenv.com/v2
BOT_TOKEN=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJlbWFpbCI6ImVzb25lLnFpdUByaW5nY2VudHJhbC5jb20iLCJzZXJ2aWNlIjoiU01fYm90LnNlcnZpY2UiLCJyb2xlIjoiUk9MRV9VU0VSIiwiaWF0IjoxNzM5OTQyMjUyLCJleHAiOjIwNTUzMDIyNTJ9.ieSb3zGIwVhUTqZpkgJipK8ktH4FVJr3vDF0kyQ-4DI
BOT_ID=4700372020@37439510.bot.glip.net
BOT_TYPE=user
# BOT_TEAM_ID=   # BOT_TYPE=team 时必填
# BOT_TARGET_EMAIL=  # 可选，不设则从 userId 推导 (esone.qiu -> esone.qiu@ringcentral.com)

# Scheduler
# PROACTIVE_SCHEDULER_ENABLED controls heartbeat, consolidation, dreaming, and
# report cron jobs. Outreach scheduling runs independently so 帮我问 / 跟进追问
# keep working even when the heavier background jobs stay off.
PROACTIVE_SCHEDULER_ENABLED=true
# Set false only to disable the outreach polling loop at deploy level. Per-user
# enablement still comes from Options / runtime config.
# OUTREACH_SCHEDULER_ENABLED=false
OUTREACH_ENABLED=true
OUTREACH_INTERVAL_MS=60000
# Lightweight source-grounded brief maintenance is independent of the full
# proactive scheduler so passive Lens briefs can stay current without enabling
# notifications, actions, consolidation, or dream jobs.
KEYSTONE_BRIEF_COMPOSER_ENABLED=true
KEYSTONE_BRIEF_COMPOSER_INTERVAL_MS=900000
# Passive browser/composer recall defaults to FTS-only for latency. Enable this
# only when vector recall latency is acceptable on the host.
CONTEXT_RECALL_PASSIVE_SEARCH_ENABLED=false
CONTEXT_RECALL_PASSIVE_VECTOR_ENABLED=false
# Route-level fallback returns an empty passive recall response before any
# synchronous DB/FTS work when passive search is disabled.
CONTEXT_RECALL_ROUTE_PASSIVE_FAST_FALLBACK_ENABLED=true
# API-serving deployments store ingest payloads without slow LLM extraction or
# local embedding indexing unless these are explicitly enabled.
INGEST_LLM_EXTRACTION_ENABLED=false
INGEST_EMBEDDING_ENABLED=false
# /recall route defaults to a safe FTS-only mode in production. Set true only
# when full vector/time/graph recall latency is acceptable for the API process.
RECALL_ROUTE_SAFE_MODE_ENABLED=true
RECALL_SLOW_CHANNELS_ENABLED=false
RECALL_SAFE_TOP_K=10
RECALL_SAFE_MAX_TOP_K=10
HEARTBEAT_INTERVAL_MS=900000
DAILY_CRON=0 23 * * *
WEEKLY_CRON=0 3 * * 0
QUIET_HOURS_START=22
QUIET_HOURS_END=8
CONTEXT_MATCH_THRESHOLD=0.50

# Outreach answer precheck windows
# before_dispatch 时，目标群/私聊历史至少回看最近 7 天
OUTREACH_BEFORE_DISPATCH_TARGET_CHANNEL_LOOKBACK_SECONDS=604800
# before_dispatch 时，全局记忆/其他群消息至少回看最近 3 天
OUTREACH_BEFORE_DISPATCH_GLOBAL_MEMORY_LOOKBACK_SECONDS=259200

# Dream Digest schedule
DREAM_DIGEST_ENABLED=true
# weekly | every_x_days | monthly
DREAM_DIGEST_SCHEDULE_TYPE=weekly
# Used when DREAM_DIGEST_SCHEDULE_TYPE=every_x_days (minimum 1)
DREAM_DIGEST_INTERVAL_DAYS=7

# Weekly Report
WEEKLY_REPORT_CRON=0 18 * * 5
WEEKLY_REPORT_ENABLED=true
WEEKLY_REPORT_MIN_MESSAGES=20

# Self Reflection
# New users default to off unless explicitly enabled by runtime config or env
REFLECTION_ENABLED=false
REFLECTION_ACTIVE_TOPIC_LIMIT=6
REFLECTION_HEARTBEAT_MINUTES=15
REFLECTION_URGENT_NOTIFY_THRESHOLD=0.88
REFLECTION_AUTO_EXECUTE_THRESHOLD=0.8
REFLECTION_URGENT_CONFIDENCE_THRESHOLD=0.9

# OpenClaw Delegation
# Shared default for users who have not configured Options → Agent 执行器.
# Per-user agentExecutors in config.json always win.
# OPENCLAW_ENABLED=false only disables reflection/linkage delegation, not Agent Task.
OPENCLAW_ENABLED=true
OPENCLAW_BASE_URL=http://claw.xmnup.com
OPENCLAW_API_KEY=
OPENCLAW_EXECUTOR_TYPE=openclaw-gateway
OPENCLAW_EXECUTOR_LABEL=Mac mini Openclaw
# Default timeout is 10 minutes for slow external systems
OPENCLAW_TIMEOUT_MS=600000
