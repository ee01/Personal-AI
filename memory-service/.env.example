# Server
PORT=3210
HOST=0.0.0.0
DATA_DIR=./data
LOG_LEVEL=info

# LLM Configuration
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GROQ_API_KEY=
DIFY_API_KEY=
# Dify API base URL (e.g. https://api.dify.ai or https://xxx/v1). DIFY_API_BASE_URL also works.
DIFY_API_URL=
# Dify app mode: chat (conversational) or completion (text generation). Use completion if you get "not_chat_app".
DIFY_APP_MODE=completion
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Embedding
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# Auth
API_KEY=

# Scheduler
HEARTBEAT_INTERVAL_MS=900000
DAILY_CRON=0 23 * * *
WEEKLY_CRON=0 3 * * 0
QUIET_HOURS_START=22
QUIET_HOURS_END=8
