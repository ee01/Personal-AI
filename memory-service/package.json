{
  "name": "personal-ai-memory-service",
  "version": "0.1.0",
  "description": "Memory service backend for Personal AI Chrome Extension",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest",
    "test:meeting-memory": "vitest --run src/__tests__/api-recall.test.ts src/__tests__/api-meetings.test.ts src/__tests__/api-ask.test.ts",
    "test:coverage": "vitest --coverage",
    "migrate": "tsx src/storage/migrate.ts",
    "migrate:multiuser": "tsx scripts/migrate-to-multiuser.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@fastify/multipart": "^9.4.0",
    "@fastify/swagger": "^9.4.0",
    "@fastify/swagger-ui": "^5.2.0",
    "@modelcontextprotocol/sdk": "^1.8.0",
    "@xenova/transformers": "^2.17.2",
    "adm-zip": "^0.5.16",
    "better-sqlite3": "^11.7.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.0",
    "node-cron": "^3.0.3",
    "sqlite-vec": "^0.1.6",
    "uuid": "^11.1.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
