{
  "manifest_version": 3,
  "name": "Personal AI",
  "description": "Your personal AI assistant that helps analyze messages and provide insights",
  "version": "3.0",
  "permissions": [
    "tabs",
    "storage",
    "activeTab",
    "alarms",
    "background",
    "unlimitedStorage",
    "offscreen"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://mfe_a-develop.jupiter.int.rclabenv.com/*", 
        "https://rc-a-develop.jupiter.int.rclabenv.com/*",
        "https://app.ringcentral.com/*"
      ],
      "js": ["contentScript.js"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Radar PoC"
  },
  "options_page": "options.html",
  "host_permissions": [
    "*://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "web_accessible_resources": [{
    "resources": ["topic-modal.html", "knowledge-query.html", "offscreen.html"],
    "matches": ["<all_urls>"]
  }],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
