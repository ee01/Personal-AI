{
  "manifest_version": 3,
  "name": "Radar Poc",
  "version": "2.0",
  "permissions": [
    "tabs",
    "storage",
    "activeTab",
    "scripting",
    "alarms",
    "background",
    "cors"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://mfe_a-develop.jupiter.int.rclabenv.com/*", 
        "https://rc-a-develop.jupiter.int.rclabenv.com/*",
        "https://app.ringcentral.com/*"
      ],
      "js": ["contentScript.js"]
    }
  ],
  "action": {
    "default_title": "Open Radar Poc",
    "default_popup": "popup.html"
  },
  "options_page": "popup.html",
  "host_permissions": [
    "http://localhost:11434/*",
    "https://integrate.api.nvidia.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
