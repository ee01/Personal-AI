# Copy to desktop-app/.env before running npm run deploy
# If you already ran `gh auth login`, GITHUB_TOKEN can be omitted.

# GitHub release upload
GITHUB_TOKEN=ghp_your_token_here
# Optional if origin is not a GitHub remote
GITHUB_REPOSITORY=ee01/personal-ai

# Optional release metadata
# GITHUB_RELEASE_TAG=desktop-v2.0.0
# GITHUB_RELEASE_TITLE=Personal AI Desktop 2.0.0
# GITHUB_RELEASE_NOTES=Automated macOS bundle for Personal AI Desktop.

# Optional signing / notarization for the generated app + installer pkg
# APPLE_APPLICATION_SIGNING_IDENTITY=Developer ID Application: Your Name (TEAMID)
# APPLE_INSTALLER_SIGNING_IDENTITY=Developer ID Installer: Your Name (TEAMID)
# APPLE_NOTARY_KEYCHAIN_PROFILE=personal-ai-notary

# Optional bridge runtime sync values if you also want local auto-sync
# MEMORY_SERVICE_BASE_URL=http://127.0.0.1:3210
# MEMORY_SERVICE_USER_ID=your-user-id
# MEMORY_SERVICE_API_KEY=
# DESKTOP_APP_AUTO_SYNC=true
# DOUBAO_BRIDGE_AUTO_SYNC=true
