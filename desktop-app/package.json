{
  "name": "personal-ai-desktop",
  "version": "4.0.0",
  "private": true,
  "type": "module",
  "description": "Local desktop app for Personal AI memory sync and context injection",
  "main": "app/main.mjs",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "node scripts/build.mjs",
    "start": "node dist/index.js",
    "app:dev": "npm run build && electron app/main.mjs",
    "app:start": "electron app/main.mjs",
    "test": "NODE_ENV=test tsx --test src/**/*.test.ts",
    "test:source-toggle-gating": "node scripts/doubao-source-toggle-gating-check.mjs",
    "test:quick-ask-status-card": "node scripts/quick-ask-status-card-check.mjs",
    "test:meeting-pilot": "node scripts/meeting-pilot-demo-check.mjs",
    "test:meeting-pilot-panorama": "node scripts/meeting-pilot-panorama-check.mjs",
    "test:meeting-pilot-build-check": "node scripts/meeting-pilot-build-check.mjs",
    "test:meeting-pilot-scene1": "node scripts/meeting-pilot-scene1-check.mjs",
    "test:meeting-pilot-scene2": "node scripts/meeting-pilot-scene2-runtime-check.mjs",
    "test:meeting-pilot-scene3": "node scripts/meeting-pilot-scene3-settings-check.mjs",
    "test:meeting-pilot-options": "node scripts/meeting-pilot-options-check.mjs",
    "test:meeting-pilot-real-site": "node scripts/meeting-pilot-real-site-check.mjs",
    "test:meeting-pilot-history": "node scripts/meeting-pilot-history-check.mjs",
    "test:meeting-pilot-all": "npm run test:meeting-pilot && npm run test:meeting-pilot-panorama && npm run test:meeting-pilot-build-check && npm run test:meeting-pilot-scene1 && npm run test:meeting-pilot-scene2 && npm run test:meeting-pilot-scene3 && npm run test:meeting-pilot-options && npm run test:meeting-pilot-history",
    "test:message-reaction-toolbar": "node scripts/message-reaction-toolbar-check.mjs",
    "macos:signing-info": "node scripts/macos-signing-info.mjs",
    "package:macos": "npm run build && node scripts/package-macos.mjs",
    "deploy": "node scripts/deploy.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "fastify": "^5.2.0",
    "playwright": "^1.52.0",
    "sherpa-onnx-node": "^1.13.0",
    "webpage-mcp": "^0.8.1"
  },
  "devDependencies": {
    "@electron/packager": "^19.1.0",
    "@types/node": "^22.0.0",
    "electron": "^41.1.0",
    "electron-builder": "^26.0.12",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "build": {
    "appId": "com.personalai.desktop",
    "productName": "Personal AI",
    "asar": false,
    "directories": {
      "output": "release/electron-builder"
    },
    "files": [
      "app/**/*",
      "dist/**/*",
      "!node_modules/playwright-core/.local-browsers{,/**}",
      "package.json",
      "package-lock.json"
    ],
    "mac": {
      "target": [
        "dir"
      ],
      "category": "public.app-category.productivity"
    }
  }
}
